{
  "name": "spaceship-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "python3 -I ../../tools/export_ui_assets.py",
    "build": "npm run gen && vite build",
    "test": "python3 -I ../../tools/export_ui_assets.py --check && vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "dev": "vite"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

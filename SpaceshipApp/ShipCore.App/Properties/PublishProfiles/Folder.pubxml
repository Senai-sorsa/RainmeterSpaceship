<Project>
  <!-- dotnet publish ShipCore.App -p:PublishProfile=Folder
       Release, framework-dependent (uses the installed .NET 10 Desktop runtime, so no 70 MB runtime copy).
       The folder stays inside SpaceshipApp so the app still finds contract\, Skins\ and SpaceshipUI\dist by walking up. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\CSpace\</PublishDir>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>

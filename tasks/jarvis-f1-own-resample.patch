+def upsample(a, factor):
+    """The clip at `factor` times its rate (2 to 4): zero-stuffed, then a Kaiser-windowed sinc low-pass (129+ taps, DC gain 1).
+    Done here, not by Windows' automatic conversion, which is what an odd-sounding 24 kHz stream goes through on some sound drivers."""
+    import numpy as np
+    a = np.asarray(a, dtype=np.float32)
+    z = np.zeros((len(a) * factor,) + a.shape[1:], np.float32)
+    z[::factor] = a
+    half = 32 * factor
+    h = np.sinc(np.arange(-half, half + 1) / factor) * np.kaiser(2 * half + 1, 8.6)
+    h = (h * (factor / h.sum())).astype(np.float32)
+    if z.ndim == 1:
+        return np.convolve(z, h, mode="same")
+    return np.stack([np.convolve(z[:, c], h, mode="same") for c in range(z.shape[1])], axis=1)
+

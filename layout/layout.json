    "w": 2560,
    "h": 1600
  },
  "safe_area": {
    "inset": 24,
    "corner_radius": 150
  },
  "min_gap": 12,
  "decor_gap": 2,
  "curves": {
    "top": {
      "type": "arc_x",
      "center_x": 1280,
      "half_span": 640,
      "depth": 30,
      "_note": "frown: outer ends of the top console sit lower"
    },
    "bottom": {
      "type": "arc_x",
      "center_x": 1280,
      "half_span": 480,
      "depth": -20,
      "_note": "smile: outer dash screens rise toward the sides"
    },
    "left": {
      "type": "wrap_y",
      "center_y": 700,
      "half_span": 600,
      "depth": 28,
      "dir": 1,
      "tilt": 0.06,
      "pivot_x": 280,
      "_note": "column wraps around the pilot: top and bottom lean inward, rows dip toward centre"
    },
    "right": {
      "type": "wrap_y",
